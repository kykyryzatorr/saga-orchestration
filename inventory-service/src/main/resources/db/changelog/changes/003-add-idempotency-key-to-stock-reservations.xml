<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-add-idempotency-key-to-stock-reservations" author="saga">

        <addColumn tableName="stock_reservations">
            <column name="idempotency_key" type="VARCHAR(255)"/>
        </addColumn>

        <createIndex tableName="stock_reservations" indexName="idx_reservation_idempotency_key" unique="true">
            <column name="idempotency_key"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
